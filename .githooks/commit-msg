#!/usr/bin/env bash
# Solverr commit-message standard enforcement (see .claude/rules/workflow.md).
# Rejects a commit whose message breaks the standard. Tracked here as the source of
# truth; activate on a clone with:  git config core.hooksPath .githooks
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")
msg=$(cat "$msg_file")
errors=()

# Let rebase / merge / revert tooling and fixup / squash through untouched.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

# 1) Conventional subject: type(scope): summary
echo "$subject" | grep -qE '^(feat|fix|docs|chore|refactor|test|perf|build|ci|style|revert)(\([a-z0-9/._ -]+\))?: .+' \
  || errors+=("subject must be 'type(scope): summary' (feat|fix|docs|chore|refactor|test|perf|build|ci|style|revert)")

# 2) Subject <= 72 chars
[ "${#subject}" -le 72 ] || errors+=("subject is ${#subject} chars (max 72)")

# 3) No em dash anywhere in the message
echo "$msg" | grep -q '—' && errors+=("contains an em dash; use commas, parentheses, periods, or colons")

# 4) No AI watermark
echo "$msg" | grep -qiE 'co-authored-by|generated with|claude\.ai/code|🤖' \
  && errors+=("contains an AI watermark (Co-Authored-By / Generated with / robot emoji)")

# 5) No BARE '#<number>' reference: it links to an issue in THIS repo, which is rarely what was meant.
#    Strip explicit owner/repo#N first (FlareSolverr/FlareSolverr#1626), then flag what remains.
#    A digit-terminated boundary keeps hex colours and '#1 priority' style prose from tripping it.
stripped=$(echo "$msg" | sed -E 's@[A-Za-z0-9._-]+/[A-Za-z0-9._-]+#[0-9]+@@g')
echo "$stripped" | grep -qE '#[0-9]+([^0-9A-Za-z]|$)' \
  && errors+=("bare '#<number>' links to a Solverr issue; use the explicit 'owner/repo#N' form")

# 6) Public-facing naming: no target-site names in the message (.claude/rules/workflow.md).
#    Heuristic rather than a name list, so this file never becomes the thing it prevents:
#    a bare domain-shaped token, or scraping vocabulary. Extend locally, never in tracked files,
#    via .githooks/deny-names.local (one grep -E pattern per line, gitignored).
name_patterns='(^|[^A-Za-z0-9./@-])[a-z0-9][a-z0-9-]{1,}\.(to|st|se|nl|cc|ws|eu|si|mx|nu|tv|onion)([^A-Za-z0-9]|$)|scrap(e|er|ers|ing|ingcourse)|torrent|magnet:|indexer name'
local_deny="$(dirname "$0")/deny-names.local"
[ -f "$local_deny" ] && name_patterns="$name_patterns|$(paste -sd'|' "$local_deny")"
hits=$(echo "$msg" | grep -inE "$name_patterns" || true)
if [ -n "$hits" ]; then
  errors+=("names a target site or uses scraping vocabulary; genericize it (see Public-facing naming):")
  errors+=("      $(echo "$hits" | head -3 | tr '\n' ' ')")
fi

if [ "${#errors[@]}" -gt 0 ]; then
  {
    echo ""
    echo "x Commit rejected: message breaks the Solverr standard (.claude/rules/workflow.md):"
    for e in "${errors[@]}"; do echo "    - $e"; done
    echo ""
    echo "  Subject: $subject"
    echo ""
  } >&2
  exit 1
fi
exit 0
